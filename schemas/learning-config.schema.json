{
  "$defs": {
    "Constant": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "constant",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "exclusiveMinimum": 0.0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "Constant",
      "type": "object"
    },
    "EnvConfig": {
      "properties": {
        "exp_name": {
          "title": "Exp Name",
          "type": "string"
        },
        "wandb_project_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wandb Project Name"
        },
        "progress_bar": {
          "default": true,
          "title": "Progress Bar",
          "type": "boolean"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "randomize_initial_state": {
          "default": true,
          "title": "Randomize Initial State",
          "type": "boolean"
        },
        "torch_deterministic": {
          "default": true,
          "title": "Torch Deterministic",
          "type": "boolean"
        },
        "device": {
          "default": "cuda",
          "title": "Device",
          "type": "string"
        },
        "timeout": {
          "default": 21600,
          "exclusiveMinimum": 0,
          "title": "Timeout",
          "type": "integer"
        },
        "action_period": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Action Period",
          "type": "integer"
        }
      },
      "required": [
        "exp_name"
      ],
      "title": "EnvConfig",
      "type": "object"
    },
    "Linear": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "linear",
          "title": "Type",
          "type": "string"
        },
        "start_value": {
          "minimum": 0.0,
          "title": "Start Value",
          "type": "number"
        },
        "end_value": {
          "minimum": 0.0,
          "title": "End Value",
          "type": "number"
        },
        "end_ratio": {
          "description": "Training progress ratio at which end_value is reached",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "End Ratio",
          "type": "number"
        }
      },
      "required": [
        "type",
        "start_value",
        "end_value",
        "end_ratio"
      ],
      "title": "Linear",
      "type": "object"
    },
    "TrainingConfig": {
      "properties": {
        "total_timesteps": {
          "title": "Total Timesteps",
          "type": "integer"
        },
        "learning_rate": {
          "discriminator": {
            "mapping": {
              "constant": "#/$defs/Constant",
              "linear": "#/$defs/Linear"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Constant"
            },
            {
              "$ref": "#/$defs/Linear"
            }
          ],
          "title": "Learning Rate"
        },
        "num_envs": {
          "default": 1,
          "title": "Num Envs",
          "type": "integer"
        },
        "num_steps": {
          "default": 2048,
          "title": "Num Steps",
          "type": "integer"
        },
        "gamma": {
          "default": 0.995,
          "title": "Gamma",
          "type": "number"
        },
        "gae_lambda": {
          "default": 0.95,
          "title": "Gae Lambda",
          "type": "number"
        },
        "num_minibatches": {
          "default": 32,
          "title": "Num Minibatches",
          "type": "integer"
        },
        "update_epochs": {
          "default": 10,
          "title": "Update Epochs",
          "type": "integer"
        },
        "norm_adv": {
          "default": true,
          "title": "Norm Adv",
          "type": "boolean"
        },
        "clip_coef": {
          "default": 0.2,
          "title": "Clip Coef",
          "type": "number"
        },
        "clip_vloss": {
          "default": false,
          "title": "Clip Vloss",
          "type": "boolean"
        },
        "ent_coef": {
          "default": 0.02,
          "title": "Ent Coef",
          "type": "number"
        },
        "vf_coef": {
          "default": 0.5,
          "title": "Vf Coef",
          "type": "number"
        },
        "max_grad_norm": {
          "default": 0.5,
          "title": "Max Grad Norm",
          "type": "number"
        },
        "target_kl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Kl"
        }
      },
      "required": [
        "total_timesteps",
        "learning_rate"
      ],
      "title": "TrainingConfig",
      "type": "object"
    }
  },
  "properties": {
    "env_config": {
      "$ref": "#/$defs/EnvConfig"
    },
    "training_config": {
      "$ref": "#/$defs/TrainingConfig"
    }
  },
  "required": [
    "env_config",
    "training_config"
  ],
  "title": "LearningConfig",
  "type": "object"
}
